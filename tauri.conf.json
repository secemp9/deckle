{
  "$schema": "https://raw.githubusercontent.com/nicokosi/tauri-v2-schema/main/tauri.conf.json",
  "productName": "Deckle",
  "version": "0.1.0",
  "identifier": "design.deckle.desktop",
  "build": {
    "beforeBuildCommand": "node build.js",
    "frontendDist": "./dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
